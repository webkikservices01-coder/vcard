{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "uploads/**",
          "constants/**",
          "admin-ui/index.html",
          "admin-ui/favicon.svg",
          "assets/brand/**"
        ]
      }
    },
    {
      "src": "admin-ui/assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/admin/assets/(.*)",
      "dest": "/admin-ui/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/card-orders",
      "schedule": "0 3 * * *"
    }
  ],
  "regions": [
    "bom1"
  ]
}
