{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["uploads/**", "constants/**"] }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "server.js" }],
  "crons": [{ "path": "/api/cron/card-orders", "schedule": "0 3 * * *" }]
}
